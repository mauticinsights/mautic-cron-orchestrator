<div class="table-responsive">
    <table class="table table-hover table-striped" id="cronJobsTable">
        <thead>
            <tr>
                {{- include('@MauticCore/Helper/tableheader.html.twig', {
                    'checkall': 'true',
                    'target': '#cronJobsTable',
                }) -}}
                <th>{{ 'mautic.cron.orchestrator.th.name'|trans }}</th>
                <th>{{ 'mautic.cron.orchestrator.th.command'|trans }}</th>
                <th>{{ 'mautic.cron.orchestrator.th.source'|trans }}</th>
                <th>{{ 'mautic.cron.orchestrator.th.frequency'|trans }}</th>
                <th class="text-nowrap">{{ 'mautic.cron.orchestrator.th.last_run'|trans }}</th>
                <th>{{ 'mautic.cron.orchestrator.th.duration'|trans }}</th>
                <th class="text-nowrap">{{ 'mautic.cron.orchestrator.th.status'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% if jobs is empty %}
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        {{ 'mautic.cron.orchestrator.no_jobs'|trans }}
                    </td>
                </tr>
            {% else %}
                {% for job in jobs %}
                    {% set rowCustomButtons = [
                        {
                            attr: {
                                href: path('mautic_cron_orchestrator_edit', { objectId: job.id }),
                                'data-toggle': 'ajax',
                            },
                            btnText: 'mautic.core.form.edit',
                            iconClass: 'ri-edit-line',
                            priority: 100,
                        },
                        {
                            attr: {
                                href: path('mautic_cron_orchestrator_run', { objectId: job.id }),
                                'data-toggle': 'ajax',
                                'data-method': 'POST',
                            },
                            btnText: 'mautic.cron.orchestrator.run_now',
                            iconClass: 'ri-play-circle-line',
                            priority: 50,
                        },
                    ] %}
                    {% if job.lastRunStatus %}
                        {% set rowCustomButtons = rowCustomButtons|merge([{
                            attr: {
                                href: path('mautic_cron_orchestrator_last_log', { objectId: job.id }),
                                'data-toggle': 'ajaxmodal',
                                'data-target': '#CronJobLogModal',
                                'data-footer': 'false',
                                'data-header': 'mautic.cron.orchestrator.last_log'|trans({'%name%': job.name})|e('html_attr'),
                            },
                            btnText: 'mautic.cron.orchestrator.show_log',
                            iconClass: 'ri-information-line',
                            priority: 40,
                        }]) %}
                    {% endif %}
                    {% set rowCustomButtons = rowCustomButtons|merge([{
                        confirm: {
                            message: 'mautic.cron.orchestrator.confirm_delete'|trans({'%name%': job.name}),
                            confirmText: 'mautic.core.form.delete'|trans,
                            confirmAction: path('mautic_cron_orchestrator_delete', { objectId: job.id }),
                            iconClass: 'ri-delete-bin-line',
                            template: 'delete',
                        },
                        priority: -1,
                    }]) %}
                    <tr class="{% if not job.isEnabled %}text-muted{% endif %}">
                        <td>
                            {{ include('@MauticCore/Helper/list_actions.html.twig', {
                                item: { id: job.id, name: job.name },
                                templateButtons: {},
                                customButtons: rowCustomButtons,
                            }) }}
                        </td>
                        <td>
                            <div class="d-flex ai-center gap-xs">
                                <a href="{{ path('mautic_cron_orchestrator_toggle', { objectId: job.id }) }}"
                                   data-toggle="ajax"
                                   data-method="POST"
                                   title="{{ (job.isEnabled ? 'mautic.core.form.active' : 'mautic.core.form.inactive')|trans }}"
                                   data-placement="right">
                                    <i class="ri-fw ri-lg {% if job.isEnabled %}ri-toggle-fill text-success{% else %}ri-toggle-line text-danger{% endif %} has-click-event"></i>
                                </a>
                                <a href="{{ path('mautic_cron_orchestrator_edit', { objectId: job.id }) }}" data-toggle="ajax">
                                    {{ job.name }}
                                </a>
                            </div>
                        </td>
                        <td><code>{{ job.command }}{% if job.arguments %} {{ job.arguments }}{% endif %}</code></td>
                        <td>
                            {% if job.preset == 'custom' %}
                                <span class="label label-default">{{ 'mautic.cron.orchestrator.preset.custom'|trans }}</span>
                            {% else %}
                                <span class="label label-info" title="{{ 'mautic.cron.orchestrator.source.preset'|trans }}">
                                    {{ ('mautic.cron.orchestrator.preset.' ~ job.preset)|trans }}
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-nowrap">{{ 'mautic.cron.orchestrator.every_minutes'|trans({'%minutes%': job.frequencyMinutes}) }}</td>
                        <td class="text-nowrap">{% if job.lastRunAt %}{{ job.lastRunAt|date('Y-m-d H:i') }}{% else %}{{ 'mautic.cron.orchestrator.never'|trans }}{% endif %}</td>
                        <td class="text-nowrap">
                            {% if job.lastDurationSeconds is not null %}
                                {{ 'mautic.cron.orchestrator.duration_seconds'|trans({'%seconds%': job.lastDurationSeconds|number_format(1)}) }}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td class="text-nowrap">
                            <div class="d-inline-flex ai-center flex-nowrap gap-xs">
                                {% set badge_class = 'label-primary' %}
                                {% if job.lastRunStatus == 'success' %}
                                    {% set badge_class = 'label-success' %}
                                {% elseif job.lastRunStatus == 'error' %}
                                    {% set badge_class = 'label-danger' %}
                                {% elseif job.lastRunStatus == 'running' %}
                                    {% set badge_class = 'label-warning' %}
                                {% endif %}
                                {% if job.lastRunStatus %}
                                    <span class="label {{ badge_class }}">{{ job.lastRunStatus }}</span>
                                    <a href="{{ path('mautic_cron_orchestrator_last_log', { objectId: job.id }) }}"
                                       class="text-muted"
                                       data-toggle="ajaxmodal"
                                       data-target="#CronJobLogModal"
                                       data-footer="false"
                                       data-header="{{ 'mautic.cron.orchestrator.last_log'|trans({'%name%': job.name})|e('html_attr') }}"
                                       title="{{ 'mautic.cron.orchestrator.view_last_log'|trans|e('html_attr') }}">
                                        <i class="ri-information-line ri-lg"></i>
                                    </a>
                                {% else %}
                                    <span class="label label-default">{{ 'mautic.cron.orchestrator.pending'|trans }}</span>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>
</div>
