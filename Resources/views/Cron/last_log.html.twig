{% if log is null %}
    <div class="alert alert-info mb-0">
        {{ 'mautic.cron.orchestrator.no_logs_yet'|trans }}
    </div>
{% else %}
    <div class="panel panel-{% if log.status == 'success' %}success{% elseif log.status == 'error' %}danger{% else %}warning{% endif %} mb-md">
        <div class="panel-heading">
            <strong>{{ log.status }}</strong>
            &mdash;
            {{ log.startedAt|date('Y-m-d H:i:s') }}
            {% if log.finishedAt %}
                &ndash; {{ log.finishedAt|date('Y-m-d H:i:s') }}
            {% endif %}
            {% if log.durationSeconds is not null %}
                ({{ 'mautic.cron.orchestrator.duration_seconds'|trans({'%seconds%': log.durationSeconds|number_format(1)}) }})
            {% endif %}
            {% if log.exitCode is not null %}
                &mdash; exit {{ log.exitCode }}
            {% endif %}
        </div>
        <div class="panel-body">
            {% if log.output %}
                <textarea class="form-control"
                          readonly
                          rows="18"
                          style="height: 360px; overflow: auto; resize: vertical; color: #000; font-family: Menlo, Monaco, Consolas, 'Courier New', monospace;">{{ log.output }}</textarea>
            {% else %}
                <span class="text-muted">{{ 'mautic.cron.orchestrator.no_log_output'|trans }}</span>
            {% endif %}
        </div>
    </div>
{% endif %}
<div class="text-right">
    <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
</div>
