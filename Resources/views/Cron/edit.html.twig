{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}cronOrchestrator{% endblock %}

{% block headerTitle %}
    {% if is_new %}
        {{ 'mautic.cron.orchestrator.add_job'|trans }}
    {% else %}
        {{ 'mautic.cron.orchestrator.edit_job'|trans({ '%name%': job.name }) }}
    {% endif %}
{% endblock %}

{% block content %}
{{ form_start(form) }}
<div class="box-layout">
    <div class="col-md-9 height-auto bdr-r">
        <div class="pa-md">
            {{ form_row(form.name) }}
            {{ form_row(form.command) }}
            {{ form_row(form.arguments) }}
            {{ form_row(form.frequencyMinutes) }}
        </div>

        {% if not is_new %}
            <div class="pa-md">
                <h4 class="fw-sb mb-md">{{ 'mautic.cron.orchestrator.recent_logs'|trans }}</h4>
                {% if recent_logs is empty %}
                    <div class="alert alert-info mb-0">
                        {{ 'mautic.cron.orchestrator.no_logs_yet'|trans }}
                    </div>
                {% else %}
                    {% for log in recent_logs %}
                        <div class="panel panel-{% if log.status == 'success' %}success{% elseif log.status == 'error' %}danger{% else %}warning{% endif %} mb-sm">
                            <div class="panel-heading">
                                <strong>{{ log.status }}</strong>
                                &mdash;
                                {{ log.startedAt|date('Y-m-d H:i:s') }}
                                {% if log.durationSeconds is not null %}
                                    ({{ log.durationSeconds|number_format(1) }}s)
                                {% endif %}
                                {% if log.exitCode is not null %}
                                    &mdash; exit {{ log.exitCode }}
                                {% endif %}
                            </div>
                            {% if log.output %}
                                <div class="panel-body">
                                    <pre class="pre-scrollable mb-0" style="max-height: 120px;">{{ log.output }}</pre>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        {% endif %}
    </div>
    <div class="col-md-3 height-auto">
        <div class="pr-lg pl-lg pt-md pb-md">
            {{ form_row(form.isEnabled) }}
        </div>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}
