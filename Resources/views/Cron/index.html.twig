{% set isIndex = tmpl is not defined or tmpl == 'index' %}
{% set tmpl = 'list' %}

{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block headerTitle %}{{ 'mautic.cron.orchestrator.title'|trans }}{% endblock %}
{% block mauticContent %}cronOrchestrator{% endblock %}

{% block content %}
    {% if isIndex %}
    {# Core confirmation Cancel uses btn-primary without an icon, so default
       padding-right (spacing-10) leaves unused space beside the label. #}
    <style>
        .confirmation-modal .btn.btn-primary,
        #CronJobLogModal .btn.btn-primary {
            padding-right: var(--spacing-05);
        }
    </style>
    <div id="page-list-wrapper" class="panel panel-default">
        {# M6 list_toolbar renders New/options via page_actions (not list_actions).
           Preset switcher is custom HTML; keep it beside New via extraHtml. #}
        {{- include('@MauticCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue|default(''),
            'action': currentRoute,
            'page_actions': {
                'extraHtml': include('@MauticCronOrchestratorBundle/Cron/_toolbar_actions.html.twig', {
                    'presets': presets,
                    'activePreset': activePreset|default(null),
                }),
            },
            'bulk_actions': {
                'target': '#cronJobsTable',
                'customButtons': [
                    {
                        'confirm': {
                            'message': 'mautic.cron.orchestrator.confirm_batch_enable'|trans,
                            'confirmText': 'mautic.core.form.active'|trans,
                            'confirmAction': path('mautic_cron_orchestrator_batch_enable'),
                            'iconClass': 'ri-toggle-fill text-success',
                            'btnText': 'mautic.cron.orchestrator.batch.enable'|trans,
                            'precheck': 'batchActionPrecheck',
                            'confirmCallback': 'executeBatchAction',
                        },
                    },
                    {
                        'confirm': {
                            'message': 'mautic.cron.orchestrator.confirm_batch_disable'|trans,
                            'confirmText': 'mautic.core.form.inactive'|trans,
                            'confirmAction': path('mautic_cron_orchestrator_batch_disable'),
                            'iconClass': 'ri-toggle-line text-danger',
                            'btnText': 'mautic.cron.orchestrator.batch.disable'|trans,
                            'precheck': 'batchActionPrecheck',
                            'confirmCallback': 'executeBatchAction',
                        },
                    },
                    {
                        'confirm': {
                            'message': 'mautic.cron.orchestrator.confirm_batch_delete'|trans,
                            'confirmText': 'mautic.core.form.delete'|trans,
                            'confirmAction': path('mautic_cron_orchestrator_batch_delete'),
                            'template': 'batchdelete',
                        },
                    },
                ],
            },
        }) -}}
        <div class="page-list">
            {{ include('@MauticCronOrchestratorBundle/Cron/_list.html.twig') }}
        </div>
    </div>
    {# Custom modal (not Helper/modal): core helper hardcodes data-backdrop="static",
       which prevents Esc from closing the dialog. #}
    <div class="modal fade"
         id="CronJobLogModal"
         tabindex="-1"
         role="dialog"
         aria-labelledby="CronJobLogModal-label"
         aria-hidden="true"
         data-keyboard="true"
         data-backdrop="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title" id="CronJobLogModal-label"></h4>
                    <div class="modal-loading-bar">{{ 'mautic.core.loading'|trans }}</div>
                </div>
                <div class="modal-body">
                    <div class="loading-placeholder">{{ 'mautic.core.loading'|trans }}</div>
                    <div class="modal-body-content"></div>
                </div>
            </div>
        </div>
    </div>
    <script>
        mQuery(function () {
            mQuery(document).off('keydown.cronJobLogModal').on('keydown.cronJobLogModal', function (e) {
                if ((e.key === 'Escape' || e.keyCode === 27) && mQuery('#CronJobLogModal').hasClass('in')) {
                    mQuery('#CronJobLogModal').modal('hide');
                }
            });
        });
    </script>
    {% else %}
        {{ include('@MauticCronOrchestratorBundle/Cron/_list.html.twig') }}
    {% endif %}
{% endblock %}
